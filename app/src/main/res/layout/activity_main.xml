<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textClockHour"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fontFamily="@font/ebssb"
        android:gravity="center"
        android:maxLines="1"
        app:autoSizeMaxTextSize="500sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/textClockMinute"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textClockMinute"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fontFamily="@font/ebsr"
        android:gravity="center"
        android:maxLines="1"
        app:autoSizeMaxTextSize="500sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintTop_toBottomOf="@+id/textClockHour"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />


</androidx.constraintlayout.widget.ConstraintLayout>